# RxTrace India - Trial-only environment template

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

CRON_SECRET=your_secure_random_string

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Handset Activation V2
HANDSET_V2_ENABLED=true
HANDSET_TOKEN_MAX_EXPIRY_HOURS=24
HANDSET_TOKEN_MAX_ACTIVATIONS=10
HANDSET_DEVICE_AUTH_SECRET=replace_with_secure_secret
HANDSET_DEVICE_AUTH_TTL_SECONDS=604800
NEXT_PUBLIC_HANDSET_V2_ENABLED=true
